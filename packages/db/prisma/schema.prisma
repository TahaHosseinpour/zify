generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator python_client {
  provider                  = "prisma-client-py"
  interface                 = "asyncio"
  recursive_type_depth      = 5
  enable_experimental_decimal = true
  output                    = "../../../apps/agent/prisma_client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                   String    @id @default(cuid())
  mobile               String    @unique
  otp                  String?
  otpExpiry            DateTime?
  // Optional scrypt password hash ("salt:hash"); set from settings so the user
  // can log in with mobile+password instead of OTP. Null = OTP-only account.
  password             String?
  fullName             String?
  isVerified           Boolean   @default(false)
  onboardingCompleted  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  shops Shop[]

  @@map("users")
}

model Shop {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  logoUrl           String?
  description       String?
  categories        String[]
  supportInfo       Json?
  personaCharacter  String?
  personaTone       String?
  systemPromptExtra String?
  // What the assistant opens a conversation with, on every channel. Null
  // means the built-in greeting.
  welcomeMessage    String?
  ownerId           String
  createdAt         DateTime @default(now())

  // Rolling-month cap on product *creates* (deploy/README-style lazy reset:
  // app code checks `now > monthlyUploadsResetAt` before incrementing, rolls
  // the window forward and zeroes the counter when it has expired, no cron
  // needed). Separate from the 1000-active-product cap so delete+recreate
  // cycling can't be used to bypass it - this counts creates, not net rows.
  monthlyProductUploads Int      @default(0)
  monthlyUploadsResetAt DateTime @default(now())

  owner         User           @relation(fields: [ownerId], references: [id])
  products      Product[]
  faqItems      FaqItem[]
  shopInfoChunks ShopInfoChunk[]
  channels      Channel[]
  endUsers      EndUser[]
  conversations Conversation[]
  events        Event[]
  orders        Order[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]

  @@map("shops")
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  productUrl  String?
  description String?
  category    String?
  brand       String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // vector column added via raw SQL migration
  // embedding Unsupported("vector(1536)")?
  // embedding_gemini Unsupported("vector(1536)")? (migration 0005)

  shop          Shop           @relation(fields: [shopId], references: [id])
  conversations Conversation[]
  orders        Order[]

  @@map("products")
}

model FaqItem {
  id       String @id @default(cuid())
  shopId   String
  question String
  answer   String

  // embedding, embedding_gemini vector(1536) added via raw SQL migrations

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("faq_items")
}

model ShopInfoChunk {
  id      String @id @default(cuid())
  shopId  String
  content String

  // embedding, embedding_gemini vector(1536) added via raw SQL migrations

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("shop_info_chunks")
}

model Channel {
  id        String   @id @default(cuid())
  shopId    String
  type      String   @default("telegram")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("channels")
}

model EndUser {
  id             String   @id @default(cuid())
  shopId         String
  // Exactly one of telegramUserId/webVisitorId is set - which channel this
  // identity came from. Both nullable-unique: Postgres allows any number of
  // NULLs in a unique index, so a Telegram row's null webVisitorId (and vice
  // versa) never collides with another row of the other kind.
  telegramUserId String?
  webVisitorId   String?
  firstName      String?
  username       String?
  createdAt      DateTime @default(now())

  // Which Conversation this user's next message continues - see
  // packages/db/src/conversations.ts. Not a Prisma relation on purpose (a
  // second relation between EndUser and Conversation, alongside
  // Conversation.endUserId, would need @relation naming on both sides for no
  // real benefit - this is just an id looked up manually when needed).
  activeConversationId String?

  // Input-token usage caps (packages/db/src/conversations.ts and
  // apps/agent/app/server.py enforce these) - lazy reset like
  // Shop.monthlyProductUploads, no cron needed.
  weeklyInputTokens  Int      @default(0)
  weeklyResetAt      DateTime @default(now())
  monthlyInputTokens Int      @default(0)
  monthlyResetAt     DateTime @default(now())

  // Abuse controls (packages/db/src/billing.ts). `lastMessageAt` enforces a
  // minimum gap between two messages; `isBlocked` is the shop owner's own
  // "stop answering this customer" switch.
  lastMessageAt DateTime?
  isBlocked     Boolean   @default(false)

  shop          Shop           @relation(fields: [shopId], references: [id])
  conversations Conversation[]
  events        Event[]
  orders        Order[]

  @@unique([shopId, telegramUserId])
  @@unique([shopId, webVisitorId])
  @@map("end_users")
}

model Conversation {
  id            String   @id @default(cuid())
  shopId        String
  endUserId     String
  mode          String   @default("explore")
  productId     String?
  startedAt     DateTime @default(now())
  // Bumped on every turn - what getOrStartConversation checks against the
  // 24h window, and what the Telegram/storefront history lists sort by.
  lastMessageAt DateTime @default(now())

  // Metering (packages/db/src/billing.ts). A conversation is what a
  // subscription sells, and it only counts against the shop's quota once the
  // customer has actually sent a message (`billedAt`) - opening a chat and
  // leaving costs the shop nothing. `userMessageCount` caps its length;
  // `costToman` is the real model spend the agent recorded for it, which caps
  // its cost no matter how the length cap was reached.
  userMessageCount Int       @default(0)
  costToman        Decimal   @default(0) @db.Decimal(12, 2)
  billedAt         DateTime?

  shop     Shop      @relation(fields: [shopId], references: [id])
  endUser  EndUser   @relation(fields: [endUserId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  messages Message[]

  @@index([shopId, billedAt])
  @@index([endUserId, billedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model Event {
  id        String   @id @default(cuid())
  shopId    String
  endUserId String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id])
  endUser EndUser? @relation(fields: [endUserId], references: [id])

  @@map("events")
}

model Order {
  id        String   @id @default(cuid())
  shopId    String
  endUserId String?
  productId String?
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id])
  endUser EndUser? @relation(fields: [endUserId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("orders")
}

// A platform admin: one of the people who run Zify itself. They see every shop
// under /admin and activate subscriptions by hand once payment has been
// received. Deliberately not a User - a different table, a different login
// (/admin/login: username + password, then a code sent by SMS), a different
// session (apps/admin/lib/admin-auth.ts). No shop owner account can become one.
model Admin {
  id          String    @id @default(cuid())
  username    String    @unique
  // scrypt "salt:hash", same format as User.password.
  password    String
  // Where the sign-in code is sent. Not a login identifier, and unrelated to
  // any User with the same number.
  mobile      String
  // The pending sign-in code, as a keyed hash - never the code itself.
  otpHash     String?
  otpExpiry   DateTime?
  fullName    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("admins")
}

// What is for sale. Prices are per month, in toman; a 3- or 12-month purchase
// is that many months at the same rate, less the plan's discount (zero by
// default: the monthly price already sits just above the cost ceiling, see
// packages/db/src/billing.ts).
model Plan {
  id                       String   @id @default(cuid())
  key                      String   @unique
  name                     String
  description              String?
  conversationsPerMonth    Int
  monthlyPriceToman        Int
  discountPercent3Months   Int      @default(0)
  discountPercent12Months  Int      @default(0)
  maxActiveProducts        Int
  maxMonthlyProductUploads Int
  maxFaqItems              Int
  maxBroadcastsPerMonth    Int
  sortOrder                Int      @default(0)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())

  @@map("plans")
}

// One activation of a plan for a shop, entered by hand by a platform admin
// once payment has been received. It carries its own copy of every limit, so
// editing a Plan later never changes what a shop already paid for - and a
// custom plan is simply a subscription whose numbers match no Plan row.
model Subscription {
  id                       String   @id @default(cuid())
  shopId                   String
  planKey                  String
  planName                 String
  months                   Int
  startsAt                 DateTime
  endsAt                   DateTime
  conversationsPerMonth    Int
  maxActiveProducts        Int
  maxMonthlyProductUploads Int
  maxFaqItems              Int
  maxBroadcastsPerMonth    Int
  priceToman               Int
  // "active" | "cancelled". Expiry is not a status: it is `endsAt` passing.
  status                   String   @default("active")
  note                     String?
  // Admin.id of whoever switched it on.
  activatedById            String?
  createdAt                DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, status, endsAt])
  @@map("subscriptions")
}

// A request from the pricing page: someone picked a plan and asked to be
// contacted. Payment and activation both happen by hand afterwards.
model Lead {
  id                    String   @id @default(cuid())
  fullName              String
  mobile                String
  shopName              String
  shopUrl               String?
  planKey               String
  months                Int
  conversationsPerMonth Int
  quotedPriceToman      Int
  message               String?
  // "new" | "contacted" | "meeting" | "paid" | "rejected"
  status                String   @default("new")
  adminNote             String?
  createdAt             DateTime @default(now())

  @@index([status, createdAt])
  @@map("leads")
}

// One row per agent turn: what it actually cost. The audit trail behind
// Conversation.costToman, written by apps/agent/app/metering.py.
model UsageRecord {
  id              String   @id @default(cuid())
  shopId          String
  conversationId  String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  jevTokens       Int      @default(0)
  embeddingTokens Int      @default(0)
  costToman       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
  @@index([conversationId])
  @@map("usage_records")
}

// Platform-wide knobs an admin can change without a deploy (the dollar rate
// every cost is converted with).
model Setting {
  key   String @id
  value String

  @@map("settings")
}
