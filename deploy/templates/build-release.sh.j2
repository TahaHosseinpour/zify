#!/usr/bin/env bash
# Zify - managed by pyinfra (deploy/tasks/website.py). Runs with the release
# directory being built as its cwd (pyinfra sets that via `_chdir` on the
# operation that uploads this).
set -euo pipefail

# --- Temporary build-time swap ---------------------------------------------
# This server carries no permanent swap on purpose - `bun install` + `uv sync`
# + `next build` back to back is the one point in this deploy that actually
# needs the headroom, so a swapfile is made just for this shell and
# `trap ... EXIT` removes it again whether the build succeeds or dies partway
# through. If a previous run crashed before its own trap fired, the
# `swapon --show` check below just reuses what's already there instead of
# erroring on a second `mkswap`.
SWAPFILE="{{ web_root }}/.build-swap"
trap 'swapoff "$SWAPFILE" 2>/dev/null || true; rm -f "$SWAPFILE"' EXIT
if ! swapon --show=NAME --noheadings 2>/dev/null | grep -qx "$SWAPFILE"; then
  fallocate -l {{ build_swap_mb }}M "$SWAPFILE" 2>/dev/null || \
    dd if=/dev/zero of="$SWAPFILE" bs=1M count={{ build_swap_mb }} status=none
  chmod 600 "$SWAPFILE"
  mkswap "$SWAPFILE" >/dev/null
  swapon "$SWAPFILE"
fi

# apps/agent/.venv/bin is put on PATH *before* it exists (uv sync creates it
# next) so the python_client generate step below can find the
# `prisma-client-py` generator script it installs there.
export PATH="$(pwd)/apps/agent/.venv/bin:/usr/local/bin:$PATH"

bun install --frozen-lockfile

# --no-dev: the `dev` group (pytest, langgraph-cli[inmem] for the local dev
# server, ...) is neither needed to run main.py in production nor safe to
# build here - it pulls in jsonschema-rs, a Rust/PyO3 extension that doesn't
# build against whatever Python uv auto-selects for a bare `>=3.12` (3.14
# here, newer than PyO3 currently supports).
(cd apps/agent && uv sync --frozen --no-dev)

# Two separate --generator runs, not one `prisma generate`: prisma-client-py
# 0.15.0 (apps/agent's pinned `prisma` Python package) validates the Node-side
# Prisma CLI's engine hash against exactly the one it expects (5.17.0's) and
# refuses to generate against anything else, including the newer version
# packages/db's own `prisma` devDependency actually resolves to - "client"
# (the JS client apps/admin uses at runtime) keeps using whatever's really
# installed; "python_client" runs through that pinned version instead.
(cd packages/db && bunx prisma generate --generator client)
(cd packages/db && bunx prisma@5.17.0 generate --generator python_client)

# --- Schema: baseline once, ordinary `migrate deploy` after that -----------
# packages/db/prisma/migrations doesn't start from an empty database - its
# earliest migration (0001_init_pgvector) ALTERs tables with no earlier
# migration in this history to create them (the schema was first synced with
# `prisma db push` during local dev, before migrations existed at all, and
# only later changes went through `migrate dev`). A plain `migrate deploy`
# against a genuinely fresh database - this one - has nothing to create those
# tables with and fails on the first migration (P3018: relation "products"
# does not exist).
#
# So: on a database this app has never touched, sync the *current*
# schema.prisma directly with `db push` - but that alone is NOT the "pgvector
# extension included" it sounds like: schema.prisma's `embedding` fields are
# commented out (Prisma can't represent the `vector` type), and 0002's
# partial/functional indexes aren't representable as `@@index` either, so
# `db push` silently creates neither. This bit everyone here once already -
# `db push` ran, every migration got marked "applied" without their SQL ever
# executing, and production was missing `embedding` entirely until caught by
# a runtime "column embedding does not exist" error.
#
# So: run `db push` for what it *does* cover (every table/column actually in
# schema.prisma), then explicitly run the on-disk SQL of migrations whose
# changes schema.prisma can't express - each one is written with `IF NOT
# EXISTS` guards for exactly this, safe to run even where `db push` already
# created something adjacent. Only THEN tell Prisma's own bookkeeping that
# every migration already on disk is applied - not run again, just recorded
# (Prisma's documented baselining procedure: https://pris.ly/d/migrate-baseline).
# Every deploy after this one finds `products` already there and takes the
# ordinary `migrate deploy` path below instead.
#
# NOT_IN_SCHEMA lists exactly those schema-unrepresentable migrations - if you
# add another one (a raw SQL feature Prisma's schema can't express: an
# extension, a partial/functional index, a custom type), guard every
# statement in it with IF NOT EXISTS/OR REPLACE/etc. and add its directory
# name here too, or `db push` will just as silently skip it again.
NOT_IN_SCHEMA="0001_init_pgvector 0002_product_filter_indexes"
(
  cd packages/db
  DATABASE_URL="$(grep -m1 '^DATABASE_URL=' .env | cut -d= -f2-)"
  if [ -z "$(psql "$DATABASE_URL" -tAc "SELECT to_regclass('public.products')")" ]; then
    echo "Empty database - baselining migration history instead of migrate deploy."
    bunx prisma db push --skip-generate
    for name in $NOT_IN_SCHEMA; do
      echo "Applying $name's SQL directly (db push can't represent it)."
      psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f "prisma/migrations/$name/migration.sql"
    done
    for migration_dir in prisma/migrations/*/; do
      bunx prisma migrate resolve --applied "$(basename "$migration_dir")"
    done
  else
    bunx prisma migrate deploy
  fi
)

(cd apps/admin && bun run build)
# Not `prisma db seed` - that CLI command only works with a "prisma.seed"
# key in package.json (which is how valida's deploy does it), and
# packages/db/package.json doesn't have one; it defines its own `db:seed`
# script (`bun prisma/seed.ts`) instead, so this runs that directly.
(cd packages/db && bun run db:seed)

# Fill any empty embedding column (rows that predate `embedding_gemini`, or
# were saved while one embedding provider was down), so the agent's fallback
# embedding provider has something to search. Only empty columns are
# requested, so this is a no-op once everything is filled, and it never fails
# the build: a provider being down today must not block a release.
(cd packages/db && bun run db:backfill-embeddings) || echo "WARNING: embedding backfill did not complete"

touch .build-complete
