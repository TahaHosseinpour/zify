# Database
DATABASE_URL="postgresql://zify:zify_secret@localhost:5432/zify_db"

# OpenAI (or compatible API)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# LangSmith (tracing/observability) — get a key at https://smith.langchain.com
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="Zify"

# JWT
JWT_SECRET="your-very-secret-jwt-key-change-in-production"

# SMS.ir
SMSIR_API_KEY="your-smsir-api-key"
SMSIR_TEMPLATE_ID="your-verify-template-id"
# Set to "true" to print OTP codes to the console instead of sending real SMS (useful for local builds)
SMS_MOCK="false"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="ZifyBot"
NEXT_PUBLIC_BOT_USERNAME="ZifyBot"

# Agent Service
AGENT_URL="http://localhost:3001"
AGENT_PORT=3001

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
