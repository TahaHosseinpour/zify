# Database
DATABASE_URL="postgresql://zify:zify_secret@localhost:5432/zify_db"

# OpenAI (or compatible API)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Failover (optional). When a base URL is set, the agent moves to that
# provider whenever the one above stops answering, and back once it recovers
# (apps/agent/app/failover.py, breaker.py). Both keys default to
# OPENAI_API_KEY - one Metis key serves every route.
#   chat:       DeepSeek, OpenAI-compatible.
#   embedding:  Gemini. Stored in its own column (embedding_gemini), so after
#               setting this run `bun run db:backfill-embeddings` once to embed
#               the rows that already exist.
# DEEPSEEK_BASE_URL="https://api.metisai.ir/deepseek/v1"
# DEEPSEEK_CHAT_MODEL="deepseek-v4-flash"
# DEEPSEEK_API_KEY=""
# Which chat provider is asked first (default: the OPENAI_* model, DeepSeek
# as the one it fails over to). "deepseek,openai" makes DeepSeek the reply
# model and the judge of the evaluations.
# CHAT_PROVIDER_ORDER="deepseek,openai"
# The same for embeddings: "gemini,openai" makes Gemini embed first.
# EMBEDDING_PROVIDER_ORDER="gemini,openai"
# GEMINI_BASE_URL="https://api.metisai.ir/v1beta"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# GEMINI_API_KEY=""
# Seconds one provider gets before the call moves on to the next.
# LLM_TIMEOUT_SECONDS="15"
# EMBEDDING_TIMEOUT_SECONDS="8"

# Intent classification (apps/agent/app/intent.py). "jev" (default) classifies
# each turn with TypeSafe's Jev through Metis, falling back to the chat model
# when Jev is unreachable or unsure; "llm" uses the chat model every turn.
# TYPESAFE_API_KEY defaults to OPENAI_API_KEY — the same Metis key works for
# both, so it only needs setting when the chat key is not a Metis key.
INTENT_CLASSIFIER="jev"
# TYPESAFE_API_KEY=""
# TYPESAFE_API_URL="https://api.metisai.ir/typesafe/v1/systemone"

# Shared secret between the admin panel / bot and the agent. When set, the
# agent rejects any request without it - always set it in production (the
# deploy generates one). Unset = no check, for local development only.
AGENT_INTERNAL_KEY=""

# Optional: a Telegram chat id that is notified of every pricing-page request.
PLATFORM_ADMIN_TELEGRAM_CHAT_ID=""

# Local models (dev only — leave unset/false in production; deploy never sets
# this). When "true", the agent and the admin panel's embedding writer both
# switch from OPENAI_* above to a local Ollama server instead — run
# `ollama serve` and pull your chat/embedding models first. Because the
# products/faq/shop-info embedding column is a fixed vector(1536), a smaller
# local embedding model (bge-m3 is 1024) is zero-padded to fit; this is exact
# for cosine distance, not an approximation, but products embedded under one
# model won't semantically match queries embedded under another — run
# "ریست حافظه دستیار" after switching so everything gets re-embedded with
# whichever model is currently active.
#
# GPU crash workaround: on some cards (seen on an older/low-VRAM NVIDIA GPU)
# Ollama's CUDA backend hard-crashes llama-server the moment it offloads any
# layer ("CUDA error: device kernel image is invalid"), and
# CUDA_VISIBLE_DEVICES does not stop Ollama's scheduler from trying anyway.
# The reliable fix is a derived model with GPU offload disabled:
#   printf 'FROM qwen3:4b\nPARAMETER num_gpu 0\n' > Modelfile.chat
#   ollama create qwen3-4b-cpu -f Modelfile.chat
#   printf 'FROM bge-m3\nPARAMETER num_gpu 0\n' > Modelfile.embed
#   ollama create bge-m3-cpu -f Modelfile.embed
# then point OLLAMA_CHAT_MODEL/OLLAMA_EMBEDDING_MODEL at the *-cpu names.
# Slower (CPU inference), but this is a dev-only path anyway.
USE_LOCAL_MODELS="false"
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="qwen3:4b"
OLLAMA_EMBEDDING_MODEL="bge-m3"

# LangSmith (tracing/observability) — get a key at https://smith.langchain.com
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="Zify"

# JWT
JWT_SECRET="your-very-secret-jwt-key-change-in-production"

# Accounts (shop owner logins and platform admins) are not configured here:
# they live in packages/db/prisma/seed-accounts.ts and are created by db:seed.

# SMS.ir
SMSIR_API_KEY="your-smsir-api-key"
SMSIR_TEMPLATE_ID="your-verify-template-id"
# Set to "true" to print OTP codes to the console instead of sending real SMS (useful for local builds)
SMS_MOCK="false"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="ZifyBot"
NEXT_PUBLIC_BOT_USERNAME="ZifyBot"

# Agent Service
AGENT_URL="http://localhost:3001"
AGENT_PORT=3001

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
